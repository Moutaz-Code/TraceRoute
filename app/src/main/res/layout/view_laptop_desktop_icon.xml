<?xml version="1.0" encoding="utf-8"?>
<!--
  One Win98 desktop icon: a picture above a label, the whole cell tappable.
  The binder fills the image (laptop_icon_<panelId>) and the label, and wires
  the tap to open that panel's window.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:clickable="true"
    android:focusable="true"
    android:padding="@dimen/handheld_offset_10">

    <ImageView
        android:id="@+id/laptop_icon_image"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/laptop_icon_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/handheld_offset_5"
        android:maxWidth="88dp"
        android:gravity="center_horizontal"
        android:fontFamily="@font/micro5_regular"
        android:textColor="@color/laptop_icon_label"
        android:textSize="22dp"
        android:shadowColor="#000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2" />

</LinearLayout>
