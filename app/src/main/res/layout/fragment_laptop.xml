<?xml version="1.0" encoding="utf-8"?>
<!--
  Win98-style victim-laptop desktop: a plain teal desktop with one icon per
  laptop panel, a floating window for the opened panel, and a Quit button.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/laptop_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/laptop_desktop_teal">

    <!-- Desktop icons: a top row (landscape is short, so a column would clip). -->
    <LinearLayout
        android:id="@+id/laptop_icon_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="horizontal"
        android:padding="@dimen/handheld_offset_10" />

    <!-- Floating Win98 window, hidden until an icon is opened. -->
    <LinearLayout
        android:id="@+id/laptop_window"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="vertical"
        android:visibility="gone"
        android:minWidth="260dp"
        android:padding="4dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/laptop_bevel_outset">

        <!-- Title bar: navy strip with title + close box. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/laptop_titlebar"
            android:paddingHorizontal="@dimen/handheld_offset_5"
            android:paddingVertical="@dimen/handheld_offset_5">

            <TextView
                android:id="@+id/laptop_window_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/micro5_regular"
                android:textColor="@color/laptop_titlebar_text"
                android:textSize="22dp" />

            <TextView
                android:id="@+id/laptop_window_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/handheld_offset_5"
                android:minWidth="28dp"
                android:gravity="center"
                android:text="X"
                android:fontFamily="@font/micro5_regular"
                android:textColor="@color/laptop_window_text"
                android:textSize="22dp"
                android:paddingHorizontal="@dimen/handheld_offset_5"
                android:background="@drawable/laptop_bevel_outset"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Client area: sunken white panel with the panel's info text. -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/laptop_bevel_inset"
            android:padding="@dimen/handheld_offset_10">

            <TextView
                android:id="@+id/laptop_window_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/micro5_regular"
                android:textColor="@color/laptop_window_text"
                android:textSize="22dp" />

        </ScrollView>

    </LinearLayout>

    <!-- Quit: closes the laptop. Top-right so the window never hides it. -->
    <TextView
        android:id="@+id/laptop_quit_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/handheld_offset_10"
        android:minWidth="64dp"
        android:gravity="center"
        android:text="Quit"
        android:fontFamily="@font/micro5_regular"
        android:textColor="@color/laptop_window_text"
        android:textSize="22dp"
        android:paddingHorizontal="@dimen/handheld_offset_10"
        android:paddingVertical="@dimen/handheld_offset_5"
        android:background="@drawable/laptop_bevel_outset"
        android:clickable="true"
        android:focusable="true" />

</FrameLayout>
