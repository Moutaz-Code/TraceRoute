<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/laptop_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#05080A"
    android:minHeight="360dp"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/laptop_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/laptop_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="VICTIM LAPTOP // ADRIAN VOSS"
            android:textColor="#D6F5E3"
            android:textSize="18sp" />

        <Button
            android:id="@+id/laptop_close_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Close" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/laptop_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="#0A191D"
        android:padding="12dp">

        <TextView
            android:id="@+id/laptop_screen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#9FD8B4"
            android:textSize="14sp" />

    </ScrollView>

    <TextView
        android:id="@+id/laptop_panel_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="LAPTOP PANELS"
        android:textColor="#5E8B73"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/laptop_panel_row_one"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/laptop_panel_messages"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Messages" />

        <Button
            android:id="@+id/laptop_panel_activity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Activity" />

        <Button
            android:id="@+id/laptop_panel_files"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Files" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/laptop_panel_row_two"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/laptop_panel_draft"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Draft" />

        <Button
            android:id="@+id/laptop_panel_clear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Clear" />

    </LinearLayout>

</LinearLayout>
