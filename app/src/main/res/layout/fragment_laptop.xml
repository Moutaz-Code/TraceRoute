<?xml version="1.0" encoding="utf-8"?>
<!--
  Win98-style victim-laptop desktop. The wallpaper image fills the back of the
  frame; the binder builds one icon per laptop panel into laptop_icon_container
  and shows laptop_window over the desktop when an icon is tapped.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/laptop_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/laptop_desktop_teal">

    <!-- Wallpaper: fills the full-screen desktop (cropped to fit, no distortion). -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/laptop_desktop" />

    <!-- Desktop icons: a top row (landscape is short, so a column would clip). -->
    <LinearLayout
        android:id="@+id/laptop_icon_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="horizontal"
        android:padding="@dimen/handheld_offset_10" />

    <!-- Floating Win98 window, hidden until an icon is opened. -->
    <LinearLayout
        android:id="@+id/laptop_window"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="vertical"
        android:visibility="gone"
        android:minWidth="260dp"
        android:padding="4dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/laptop_bevel_outset">

        <!-- Title bar: navy strip with title + close box. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/laptop_titlebar"
            android:paddingHorizontal="@dimen/handheld_offset_5"
            android:paddingVertical="@dimen/handheld_offset_5">

            <TextView
                android:id="@+id/laptop_window_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/micro5_regular"
                android:textColor="@color/laptop_titlebar_text"
                android:textSize="22dp" />

            <TextView
                android:id="@+id/laptop_window_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/handheld_offset_5"
                android:minWidth="28dp"
                android:gravity="center"
                android:text="X"
                android:fontFamily="@font/micro5_regular"
                android:textColor="@color/laptop_window_text"
                android:textSize="22dp"
                android:paddingHorizontal="@dimen/handheld_offset_5"
                android:background="@drawable/laptop_bevel_outset"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Client area: sunken white panel with the panel's info text. -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/laptop_bevel_inset"
            android:padding="@dimen/handheld_offset_10">

            <TextView
                android:id="@+id/laptop_window_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/micro5_regular"
                android:textColor="@color/laptop_window_text"
                android:textSize="22dp" />

        </ScrollView>

    </LinearLayout>

    <!-- Invisible "go back" hit area over the wallpaper's Start button. -->
    <View
        android:id="@+id/laptop_taskbar_back"
        android:layout_width="96dp"
        android:layout_height="36dp"
        android:layout_gravity="bottom|start"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true" />

</FrameLayout>
