<?xml version="1.0" encoding="utf-8"?>
<!--
  One key/value row of the drill-in table (think JSON: "key": "value"). Two
  styled cells; the small start margin on the value keeps the two backgrounds
  reading as separate columns.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="@dimen/handheld_offset_10"
    android:minHeight="48dp">

    <TextView
        android:id="@+id/handheld_table_key"
        style="@style/handheld_record"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical" />

    <TextView
        android:id="@+id/handheld_table_value"
        style="@style/handheld_record"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:layout_marginStart="@dimen/handheld_offset_5"
        android:gravity="center_vertical" />

</LinearLayout>
