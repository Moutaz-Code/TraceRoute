<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/handheld_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC05080A">

    <LinearLayout
        android:id="@+id/handheld_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="28dp"
        android:background="#E8081114"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/handheld_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/handheld_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HANDHELD // EVIDENCE"
                android:textColor="#D6F5E3"
                android:textSize="18sp" />

            <Button
                android:id="@+id/handheld_close_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Close" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/handheld_tab_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/handheld_evidence_tab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Evidence" />

            <Button
                android:id="@+id/handheld_threads_tab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Threads" />

            <Button
                android:id="@+id/handheld_timeline_tab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Timeline" />

            <Button
                android:id="@+id/handheld_statements_tab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Statements" />

        </LinearLayout>

        <TextView
            android:id="@+id/handheld_empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="No evidence collected."
            android:textColor="#9FD8B4"
            android:textSize="15sp" />

        <ScrollView
            android:id="@+id/handheld_evidence_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/handheld_evidence_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

    </LinearLayout>

</FrameLayout>
