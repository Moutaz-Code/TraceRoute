<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/terminal_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#05080A"
    android:minHeight="360dp"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/terminal_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="APARTMENT TERMINAL"
        android:textColor="#D6F5E3"
        android:textSize="18sp" />

    <ScrollView
        android:id="@+id/terminal_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="#0A191D"
        android:padding="12dp">

        <TextView
            android:id="@+id/terminal_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#9FD8B4"
            android:textSize="14sp" />

    </ScrollView>

    <TextView
        android:id="@+id/terminal_command_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="AUTHORED COMMANDS"
        android:textColor="#5E8B73"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/terminal_command_row_one"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/terminal_command_help"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Help" />

        <Button
            android:id="@+id/terminal_command_evidence"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Evidence" />

        <Button
            android:id="@+id/terminal_command_messages"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Messages" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/terminal_command_row_two"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/terminal_command_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Body" />

        <Button
            android:id="@+id/terminal_command_logs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Logs" />

        <Button
            android:id="@+id/terminal_command_laptop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Laptop" />

        <Button
            android:id="@+id/terminal_command_clear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Clear" />

    </LinearLayout>

</LinearLayout>
